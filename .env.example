# PayPal OAuth credentials
# Create an app at developer.paypal.com → My Apps & Credentials
# Enable "Log In with PayPal" and add /api/auth/callback to Return URLs
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# OAuth base URLs (change to production when ready)
PAYPAL_OAUTH_BASE=https://www.sandbox.paypal.com
PAYPAL_API_BASE=https://api.sandbox.paypal.com
PAYPAL_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Session encryption — must be 32+ characters, keep secret
SESSION_PASSWORD=change-me-to-a-random-32-char-secret-key

# Activity data mode:
#   sample   = curated sample data (default, works anywhere)
#   internal = real PayPal Activity APIs (PayPal network only)
ACTIVITY_MODE=sample

# Only needed when ACTIVITY_MODE=internal
# INTERNAL_ACTIVITY_BASE=https://your-internal-paypal-endpoint.com
